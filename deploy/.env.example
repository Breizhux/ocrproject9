# =============================================================================
# SEUL fichier de config à remplir. Copier vers deploy/.env (jamais commité),
# remplir les valeurs, puis lancer le conteneur (voir README § Déploiement).
#
# Ce qui N'EST PAS ici est volontaire :
#  - type de source : forcément `csv_events` (consigne), fixé dans le template ;
#  - token ragifix : interne au conteneur, généré à chaque démarrage
#    (sauf RAGIFIX_API_TOKEN fourni explicitement) ;
#  - chunking, vectorstore faiss, chemins internes : repris de la config
#    actuelle, fixés dans les templates (deploy/*.yaml.tpl).
# =============================================================================

# --- Données : CSV d'événements monté dans le conteneur (volume -v ...:/data) ---
EVENTS_CSV_PATH=/data/events_propres.csv

# --- Embedding distant (endpoint compatible OpenAI, ex. Mistral) ---
EMBEDDING_BASE_URL=https://api.mistral.ai/v1
EMBEDDING_API_KEY=sk-a-mettre-dans-deploy/.env
EMBEDDING_MODEL=mistral-embed

# --- LLM du chatbot (endpoint Mistral par défaut ; compatible OpenAI si renseigné) ---
# Laisser LLM_BASE_URL vide = endpoint Mistral par défaut.
LLM_BASE_URL=
LLM_API_KEY=sk-a-mettre-dans-deploy/.env
LLM_MODEL=mistral-small-latest

# --- Optionnel : figer le token interne ragifix (défaut = généré au démarrage) ---
# RAGIFIX_API_TOKEN=
